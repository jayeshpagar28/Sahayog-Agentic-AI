# Claude Code runtime state (agent definitions under .claude/agents/ ARE tracked)
.claude/scheduled_tasks.lock

# Playwright MCP session snapshots/console logs (scratch, regenerated every run)
.playwright-mcp/

# Microsoft Office lock files
~$*.xlsx

# Live-application artefacts containing real applicant PII - never commit
STAFF_TS001-summary-screen.png
summary-response.json

# Local credentials / third-party fixtures - never commit
.env.local
.env
