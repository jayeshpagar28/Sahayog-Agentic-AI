
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/tests/.auth/
/screenshots/

# Live-input signal files for manually-assisted tests (e.g. FUI_TS001 TC-FUI-020,
# FP_TS001 TC-FP-020, AA_TS001 TC-AA-020, Savings Account flow specs)
.fui-*-input.txt
.fp-*-input.txt
.aa-otp-input.txt
.sil-*-input.txt
.nor-*-input.txt

# Claude Code runtime state (agent definitions under .claude/agents/ ARE tracked)
.claude/scheduled_tasks.lock

# Playwright MCP session snapshots/console logs (scratch, regenerated every run)
.playwright-mcp/

# Microsoft Office lock files
~$*.xlsx
